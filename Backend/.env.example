# Copy this file to .env and fill in the values. Never commit .env.
# (Copy, don't rename: this template stays in git for teammates.)

# Signs login cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional Gemini tuning. Defaults are chosen for fast responses.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.6-flash      # used if the main model is busy
# GEMINI_THINKING_LEVEL=minimal               # minimal is fastest
# GEMINI_TIMEOUT_SECONDS=30

# Optional: recipe generations allowed per user
# GENERATE_PER_MINUTE=10
# GENERATE_PER_DAY=100

# Optional: set to 1 when the site is served over HTTPS
# SESSION_COOKIE_SECURE=1

# Optional: path to the SQLite database file (default: Backend/recipe_it.db)
# DATABASE_PATH=
